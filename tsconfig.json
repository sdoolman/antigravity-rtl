{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "types/**/*",
    "bin/index.js",
    "bin/patch-app.js",
    "bin/patch-ide.js",
    "bin/rtl-core.js",
    "test/**/*"
  ]
}
